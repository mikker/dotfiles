#!/usr/bin/env python3
import argparse
import pathlib
import sys
import tomllib

ROOT = pathlib.Path(__file__).resolve().parent.parent
SOURCE = ROOT / "design-system" / "tokens.toml"


def css_name(name):
    return name.replace("_", "-")


def css_value(value):
    if isinstance(value, bool):
        return str(value).lower()
    if isinstance(value, float) and value.is_integer():
        return str(int(value))
    return str(value)


def css_document(tokens):
    lines = ["/* Generated by script/design-system. Do not edit. */", ":root {"]
    for key, value in tokens["wide-gamut"].items():
        lines.append(f"  --wide-gamut-{css_name(key)}: {css_value(value)};")
    for section in ("type", "spacing", "radius", "blur", "motion"):
        for key, value in tokens[section].items():
            suffix = ""
            if (section in {"spacing", "radius", "blur"} or (section == "type" and key.startswith("size-"))) and isinstance(value, (int, float)) and not isinstance(value, bool):
                suffix = "px"
            elif section == "motion" and key in {"fast", "standard", "slow"}:
                suffix = "ms"
            lines.append(f"  --{section}-{css_name(key)}: {css_value(value)}{suffix};")
    for family in ("subtle", "glass", "glass-dark"):
        for key, value in tokens["border"][family].items():
            suffix = "px" if key.endswith("width") else ""
            lines.append(f"  --border-{family}-{css_name(key)}: {css_value(value)}{suffix};")
    for family in ("low", "floating"):
        for key, value in tokens["shadow"][family].items():
            suffix = "px" if key in {"blur", "x", "y"} else ""
            lines.append(f"  --shadow-{family}-{css_name(key)}: {css_value(value)}{suffix};")
    lines.append("}")
    for mode in ("light", "dark"):
        lines.append(f'\n:root[data-theme="{mode}"], .theme-{mode} {{')
        for key, value in tokens["color"][mode].items():
            lines.append(f"  --color-{css_name(key)}: {css_value(value)};")
        for key, value in tokens["control"][mode].items():
            lines.append(f"  --control-{css_name(key)}: {css_value(value)};")
        for key, value in tokens["chrome"][mode].items():
            lines.append(f"  --chrome-{css_name(key)}: {css_value(value)};")
        lines.append("}")
    p3_accent = tokens["wide-gamut"]["accent"]
    lines.extend([
        "",
        f"@supports (color: {p3_accent}) {{",
        "  @media (color-gamut: p3) {",
        '    :root[data-theme="light"], .theme-light,',
        '    :root[data-theme="dark"], .theme-dark {',
        "      --color-accent: var(--wide-gamut-accent);",
        "      --color-focus: var(--wide-gamut-accent);",
        "      --control-primary-background: var(--wide-gamut-accent);",
        "      --control-toggle-on-background: var(--wide-gamut-accent);",
        "      --control-slider-fill: var(--wide-gamut-accent);",
        "      --control-focus-ring: var(--wide-gamut-accent);",
        "    }",
        "  }",
        "}",
    ])
    return "\n".join(lines) + "\n"


def shell_surface(tokens, mode, section):
    color = tokens["color"][mode]
    border = tokens["border"]["glass-dark" if mode == "dark" else "glass"]
    shadow = tokens["shadow"]["floating"]
    blur = tokens["blur"]["tooltip" if section == "tooltip" else "floating"]
    return "\n".join([
        f"[{section}]",
        f'background = "{color["surface-raised"]}"',
        f'background-alpha = {color["surface-raised-alpha"]}',
        f'text = "{color["text-primary"]}"',
        f'border = "{border["color"]}"',
        f'border-alpha = {border["alpha"]}',
        f'border-width = {border["width"]}',
        f'inner-border = "{border["inner-color"]}"',
        f'inner-border-alpha = {border["inner-alpha"]}',
        f'inner-border-width = {border["inner-width"]}',
        f'shadow-color = "{shadow["color"]}"',
        f'shadow-alpha = {shadow["alpha"]}',
        f'shadow-blur = {shadow["blur"]}',
        f'shadow-x = {shadow["x"]}',
        f'shadow-y = {shadow["y"]}',
        f'backdrop-blur = {blur}',
        *( [f'countdown = "{color["accent"]}"'] if section == "notifications" else [] ),
        "",
    ])


def shell_font(tokens):
    font = tokens["type"]
    return "\n".join([
        "[font]",
        f'base-size = {font["base-size"]}',
        f'caption = {font["size-small"]}',
        f'body = {font["size-body"]}',
        f'title = {font["size-title"]}',
        f'ui-family = "{font["ui"]}"',
        f'ui-strong-family = "{font["ui-strong"]}"',
        f'bar-family = "{font["bar"]}"',
        f'icon-family = "{font["mono"]}"',
        "",
    ])


def shell_controls(tokens, mode):
    color = tokens["color"][mode]
    control = tokens["control"][mode]
    return "\n".join([
        "[controls]",
        f'normal-color = "{color["text-primary"]}"',
        "normal-fill-alpha = 0.04",
        f'normal-border = "{color["text-primary"]}"',
        "normal-border-width = 1",
        "normal-border-alpha = 0.40",
        f'hover-cursor-color = "{control["focus-ring"]}"',
        f'hover-cursor-fill-alpha = {control["hover-fill-alpha"]}',
        f'hover-cursor-border = "{control["focus-ring"]}"',
        "hover-cursor-border-width = 1",
        "hover-cursor-border-alpha = 0.45",
        f'focus-color = "{control["focus-ring"]}"',
        "focus-fill-alpha = 0.10",
        f'focus-border = "{control["focus-ring"]}"',
        "focus-border-width = 1",
        "focus-border-alpha = 1.0",
        f'selected-color = "{control["primary-background"]}"',
        f'selected-fill-alpha = {control["selected-fill-alpha"]}',
        f'selected-border = "{control["primary-background"]}"',
        "selected-border-width = 0",
        "selected-border-alpha = 1.0",
        "pressed-fill-alpha = 0.24",
        "selection-fill-alpha = 0.28",
        "",
    ])


def shell_bar(tokens, mode):
    color = tokens["color"][mode]
    chrome = tokens["chrome"][mode]
    return "\n".join([
        "[bar]",
        f'background = "{color["surface-raised"]}"',
        f'background-alpha = {chrome["bar-background-alpha"]}',
        f'text = "{color["text-primary"]}"',
        f'active = "{color["danger"]}"',
        "scale-with-font = false",
        "size-horizontal = 29",
        "size-vertical = 28",
        "",
    ])


def shell_spacing(tokens):
    spacing = tokens["spacing"]
    lines = ["[spacing]"]
    for key, value in spacing.items():
        if key == "unit":
            continue
        lines.append(f"{key} = {css_value(value)}")
    lines.append("")
    return "\n".join(lines)


def shell_hyprland(tokens, mode):
    color = tokens["color"][mode]
    return "\n".join([
        "[hyprland]",
        f'active-border = "{color["accent"]}"',
        f'active-border-foreground = "{color["text-primary"]}"',
        "",
    ])


def shell_overlay(tokens, mode, section):
    color = tokens["color"][mode]
    control = tokens["control"][mode]
    chrome = tokens["chrome"][mode]
    return "\n".join([
        f"[{section}]",
        f'background = "{color["surface-raised"]}"',
        f'background-alpha = {chrome["overlay-background-alpha"]}',
        f'text = "{color["text-primary"]}"',
        f'border = "{color["accent"]}"',
        "border-alpha = 1.0",
        "border-width = 2",
        f'scrim = "{color["canvas"]}"',
        f'scrim-alpha = {chrome["scrim-alpha"]}',
        f'selected-background = "{control["primary-background"]}"',
        f'selected-background-alpha = {control["selected-fill-alpha"]}',
        f'selected-text = "{color["text-primary"]}"',
        f'selected-border = "{control["focus-ring"]}"',
        "selected-border-alpha = 0.45",
        "",
    ])


def palette_document(tokens, mode):
    palette = tokens["palette"][mode]
    lines = [f'mode = "{palette["mode"]}"', ""]
    for key, value in palette.items():
        if key == "mode":
            continue
        lines.append(f'{key} = "{value}"')
    return "\n".join(lines) + "\n"


def hunk_document(tokens, mode):
    color = tokens["color"][mode]
    syntax = tokens["syntax"][mode]
    base = "paper" if mode == "light" else "graphite"
    label = "Mekanikos Light" if mode == "light" else "Mekanikos Dark"
    lines = [
        'theme = "custom"',
        'mode = "auto"',
        'watch = false',
        'exclude_untracked = false',
        'line_numbers = true',
        'wrap_lines = false',
        'hunk_headers = true',
        'agent_notes = true',
        '',
        '[custom_theme]',
        f'base = "{base}"',
        f'label = "{label}"',
        f'accent = "{color["accent"]}"',
        f'panel = "{color["canvas"]}"',
        f'panelAlt = "{color["surface-alt"]}"',
        f'text = "{color["text-primary"]}"',
        f'muted = "{color["text-muted"]}"',
        f'border = "{color["border-solid"]}"',
        f'noteBorder = "{color["note-border"]}"',
        f'add = "{color["diff-add"]}"',
        f'delete = "{color["diff-delete"]}"',
        f'selection = "{color["selection"]}"',
        '',
        '[custom_theme.syntax]',
    ]
    for key, value in syntax.items():
        lines.append(f'{key} = "{value}"')
    return "\n".join(lines) + "\n"


def qml_adapter():
    return '''// Generated by script/design-system. Do not edit.
.pragma library

function raw(values, key, fallback) {
  if (!values) return fallback
  var value = values[key]
  return value === undefined || value === null || String(value).length === 0 ? fallback : value
}

function number(values, key, fallback) {
  var value = Number(raw(values, key, fallback))
  return isFinite(value) ? value : fallback
}

function color(values, key, fallback) {
  return String(raw(values, key, fallback))
}

function shadow(values, section) {
  var prefix = String(section || "popups") + "."
  return {
    color: color(values, prefix + "shadow-color", "#10131A"),
    alpha: number(values, prefix + "shadow-alpha", 0.12),
    blur: number(values, prefix + "shadow-blur", 18),
    x: number(values, prefix + "shadow-x", 0),
    y: number(values, prefix + "shadow-y", 4),
  }
}

function innerBorder(values, section) {
  var prefix = String(section || "popups") + "."
  return {
    color: color(values, prefix + "inner-border", "#2C363C"),
    alpha: number(values, prefix + "inner-border-alpha", 0.14),
    width: number(values, prefix + "inner-border-width", 0.5),
  }
}

function gutterLeft(shadow) { return Math.max(0, shadow.blur - shadow.x) }
function gutterTop(shadow) { return Math.max(0, shadow.blur - shadow.y) }
function gutterRight(shadow) { return Math.max(0, shadow.blur + shadow.x) }
function gutterBottom(shadow) { return Math.max(0, shadow.blur + shadow.y) }
'''


def outputs(tokens):
    result = {ROOT / "design-system" / "tokens.css": css_document(tokens)}
    for plugin in ("mikker.bar", "mikker.notifications", "mikker.osd"):
        result[ROOT / "omarchy" / "plugins" / plugin / "DesignTokens.js"] = qml_adapter()
    themes = {"dark": "mekanikos", "light": "mekanikos-light"}
    for mode, slug in themes.items():
        result[ROOT / "omarchy-themes" / slug / "colors.toml"] = palette_document(tokens, mode)
        result[ROOT / "omarchy-themes" / slug / "shell.bar.toml"] = shell_bar(tokens, mode)
        result[ROOT / "omarchy-themes" / slug / "shell.hyprland.toml"] = shell_hyprland(tokens, mode)
        result[ROOT / "omarchy-themes" / slug / "shell.font.toml"] = shell_font(tokens)
        result[ROOT / "omarchy-themes" / slug / "shell.spacing.toml"] = shell_spacing(tokens)
        result[ROOT / "omarchy-themes" / slug / "shell.controls.toml"] = shell_controls(tokens, mode)
        for section in ("launcher", "menu"):
            result[ROOT / "omarchy-themes" / slug / f"shell.{section}.toml"] = shell_overlay(tokens, mode, section)
        for section in ("popups", "notifications", "tooltip"):
            result[ROOT / "omarchy-themes" / slug / f"shell.{section}.toml"] = shell_surface(tokens, mode, section)
        result[ROOT / "hunk" / f"config.{mode}.toml"] = hunk_document(tokens, mode)
    return result


def generate(expected):
    for path, content in expected.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(content)
        print(path.relative_to(ROOT))


def check(expected):
    stale = []
    for path, content in expected.items():
        if not path.exists() or path.read_text() != content:
            stale.append(str(path.relative_to(ROOT)))
    if stale:
        print("Generated design-system files are stale:", file=sys.stderr)
        for path in stale:
            print(f"  {path}", file=sys.stderr)
        print("Run: script/design-system generate", file=sys.stderr)
        return 1
    print("Design-system outputs are current")
    return 0


def main():
    parser = argparse.ArgumentParser(description="Generate and validate Mekanikos design tokens")
    parser.add_argument("command", choices=("generate", "check"))
    args = parser.parse_args()
    with SOURCE.open("rb") as source:
        tokens = tomllib.load(source)
    expected = outputs(tokens)
    if args.command == "generate":
        generate(expected)
        return 0
    return check(expected)


if __name__ == "__main__":
    raise SystemExit(main())
