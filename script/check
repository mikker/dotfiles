#!/usr/bin/env bash
set -u

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
failures=0
warnings=0

pass() { printf 'ok   %s\n' "$1"; }
warn() { printf 'warn %s\n' "$1"; warnings=$((warnings + 1)); }
fail() { printf 'FAIL %s\n' "$1" >&2; failures=$((failures + 1)); }

check_shell_syntax() {
  local file first
  while IFS= read -r file; do
    [[ -f "$DOTFILES_ROOT/$file" ]] || continue
    [[ "$(head -c 2 "$DOTFILES_ROOT/$file" 2>/dev/null || true)" == '#!' ]] || continue
    first=$(head -n 1 "$DOTFILES_ROOT/$file" 2>/dev/null || true)
    case "$first" in
      '#!'*bash*|'#!'*'/sh')
        /bin/bash -n "$DOTFILES_ROOT/$file" || fail "shell syntax: $file"
        ;;
      '#!'*zsh*)
        if command -v zsh >/dev/null; then
          zsh -n "$DOTFILES_ROOT/$file" || fail "zsh syntax: $file"
        fi
        ;;
    esac
  done < <(git -C "$DOTFILES_ROOT" ls-files)
  if grep -n 'mapfile' "$DOTFILES_ROOT/script/setup" "$DOTFILES_ROOT/script/lib.sh" >/dev/null; then
    fail "bootstrap uses Bash features unavailable in macOS Bash 3.2"
  fi
  pass "shell syntax"
}

check_link_safety() {
  local sandbox
  sandbox=$(mktemp -d)
  mkdir -p "$sandbox/repo" "$sandbox/home"
  printf 'source\n' > "$sandbox/repo/source"
  printf 'replace\n' > "$sandbox/home/dest"

  (
    DOTFILES_ROOT="$sandbox/repo"
    source "$DOTFILES_ROOT_ORIGINAL/script/lib.sh"
    link_path source "$sandbox/home/dest" >/dev/null
    same_link "$sandbox/home/dest" "$sandbox/repo/source"
    link_path source "$sandbox/home/dest" >/dev/null
    same_link "$sandbox/home/dest" "$sandbox/repo/source"
  ) || fail "link_path force replacement and idempotence"
  rm -rf "$sandbox"
  pass "link force replacement and idempotence"
}

check_executables() {
  local file first kind
  while IFS= read -r file; do
    [[ "$file" == agents.symlink/skills/* || "$file" == agents.symlink/skills-bak/* ]] && continue
    [[ -f "$DOTFILES_ROOT/$file" && ! -L "$DOTFILES_ROOT/$file" ]] || continue
    [[ -x "$DOTFILES_ROOT/$file" ]] || continue
    first=$(head -c 2 "$DOTFILES_ROOT/$file" 2>/dev/null || true)
    [[ "$first" == '#!' ]] && continue
    kind=$(file -b "$DOTFILES_ROOT/$file")
    case "$kind" in
      Mach-O*|ELF*) ;;
      *) fail "executable lacks shebang: $file" ;;
    esac
  done < <(git -C "$DOTFILES_ROOT" ls-files)
  pass "executable shebangs"
}

check_structured_files() {
  if command -v python3 >/dev/null; then
    python3 - "$DOTFILES_ROOT" <<'PY' || fail "JSON/TOML parsing"
import json, pathlib, sys, tomllib
root = pathlib.Path(sys.argv[1])
for path in root.rglob("*.json"):
    if ".git" not in path.parts:
        json.loads(path.read_text())
for path in root.rglob("*.toml"):
    if ".git" not in path.parts:
        tomllib.loads(path.read_text())
PY
    pass "JSON/TOML parsing"
  else
    warn "python3 unavailable; skipped JSON/TOML parsing"
  fi
}

check_brewfile() {
  local brewfile file
  for brewfile in Brewfile Brewfile.desktop; do
    [[ -f "$DOTFILES_ROOT/macos/brew/$brewfile" ]] || fail "missing $brewfile"
  done

  # Each CLI tool has one owner. jq is the documented exception: sketchybar
  # plugins run outside the shell and need Homebrew's copy.
  local tool
  while IFS= read -r tool; do
    [[ "$tool" == jq ]] && continue
    for file in macos/brew/Brewfile macos/brew/Brewfile.desktop linux/apt-packages linux/pacman-packages linux/aur-packages; do
      if grep -Eq "^(brew\\(\"$tool\"|$tool\$)" "$DOTFILES_ROOT/$file"; then
        fail "$tool is owned by both mise and $file"
      fi
    done
  done < <(mise_tools)
  pass "Brew dependency declarations"
}

# Tool names declared in mise/config.toml's [tools] table.
mise_tools() {
  awk '/^\[/ { in_tools = ($0 == "[tools]") } in_tools && /^[a-z0-9-]+ *=/ { print $1 }' \
    "$DOTFILES_ROOT/mise/config.toml"
}

check_linux_dependencies() {
  local package manifest
  local pacman_manifest="$DOTFILES_ROOT/linux/pacman-packages"
  local apt_manifest="$DOTFILES_ROOT/linux/apt-packages"

  [[ -f "$pacman_manifest" ]] || { fail "missing pacman package manifest"; return; }
  for package in git mise tmux ttf-ibmplex-mono-nerd ttf-iosevka-nerd zsh; do
    grep -Fxq "$package" "$pacman_manifest" || fail "pacman package manifest missing $package"
  done
  [[ -f "$apt_manifest" ]] || { fail "missing apt package manifest"; return; }
  for package in curl git git-lfs patchelf tmux zsh; do
    grep -Fxq "$package" "$apt_manifest" || fail "apt package manifest missing $package"
  done
  grep -Fxq 'ticket' "$DOTFILES_ROOT/linux/aur-packages" ||
    fail "Linux AUR package manifest missing ticket"
  for manifest in arch ubuntu; do
    [[ -f "$DOTFILES_ROOT/linux/$manifest.sh" ]] || fail "missing $manifest dependency installer"
  done
  grep -Fq 'bat cache --build' "$DOTFILES_ROOT/bat/all.sh" ||
    fail "bat installer does not rebuild the theme cache"
  grep -Fq 'run_linux_dependency_installer' "$DOTFILES_ROOT/script/setup" ||
    fail "setup does not dispatch Linux dependencies"
  pass "Linux dependency declarations"
}

check_ghostty_linux() {
  local installer="$DOTFILES_ROOT/ghostty/linux.desktop.sh"

  [[ -f "$installer" ]] || { fail "missing Ghostty Linux installer"; return; }
  grep -Fq 'config-file = ?"~/.dotfiles/ghostty/config"' "$installer" ||
    fail "Ghostty Linux installer does not include the dotfiles config"
  pass "Ghostty Linux config include"
}

check_omarchy_config() {
  local studio="${WHITE_PILL_STUDIO:-$HOME/dev/white-pill-studio}"
  [[ -f "$DOTFILES_ROOT/omarchy/config/shell.json" ]] || fail "missing Omarchy shell config"
  [[ -d "$DOTFILES_ROOT/omarchy/plugins/mikker.bar" ]] || fail "missing custom Omarchy bar"
  [[ -d "$DOTFILES_ROOT/omarchy-themes/mekanikos" ]] || fail "missing Mekanikos theme"
  [[ -d "$DOTFILES_ROOT/omarchy-themes/mekanikos-light" ]] || fail "missing Mekanikos Light theme"
  if [[ -x "$studio/script/design-system" ]]; then
    WHITE_PILL_DOTFILES="$DOTFILES_ROOT" "$studio/script/design-system" check ||
      fail "generated design-system files"
  else
    fail "White Pill Studio not found at $studio"
  fi
  grep -Fq 'bobbynicholas.omaland https://github.com/bobby-nicholas/omaland.git' "$DOTFILES_ROOT/omarchy/plugins/git" ||
    fail "missing external Omarchy plugin declaration"
  pass "Omarchy config and themes"
}

check_mise() {
  grep -Fq 'node = "26"' "$DOTFILES_ROOT/mise/config.toml" || fail "Node major is not pinned"
  grep -Fq 'bun = "1"' "$DOTFILES_ROOT/mise/config.toml" || fail "Bun major is not pinned"
  grep -Fq 'ruby = "4"' "$DOTFILES_ROOT/mise/config.toml" || fail "Ruby major is not pinned"
  grep -Fq 'mise activate zsh' "$DOTFILES_ROOT/zsh/zshrc.symlink" || fail "Mise is not activated by zshrc"
  local tool
  for tool in neovim ripgrep fzf oh-my-posh pi; do
    mise_tools | grep -Fxq "$tool" || fail "mise does not own $tool"
  done
  # oh-my-posh comes from mise, so mise must be active before the prompt starts.
  awk '/mise activate zsh/ && !mise { mise = NR } /oh-my-posh init/ && !omp { omp = NR } END { exit !(mise && omp && mise < omp) }' \
    "$DOTFILES_ROOT/zsh/zshrc.symlink" || fail "zshrc initializes oh-my-posh before activating mise"
  pass "Mise ownership"
}

check_portability() {
  if grep -Fq '/opt/homebrew/bin/gh auth git-credential' "$DOTFILES_ROOT/git/gitconfig.symlink"; then
    fail "GitHub credential helper is pinned to Homebrew"
  fi
  grep -Fq '!/usr/bin/env gh auth git-credential' "$DOTFILES_ROOT/git/gitconfig.symlink" ||
    fail "GitHub credential helper is not portable"
  [[ -f "$DOTFILES_ROOT/linux/shared.sh" ]] || fail "shared Linux installer is missing"
  pass "macOS/Linux portability"
}

check_symlinks() {
  local source dest target
  while IFS= read -r source; do
    dest="$HOME/.${source##*/}"
    dest="${dest%.symlink}"
    [[ -e "$dest" || -L "$dest" ]] || { warn "missing managed path: $dest"; continue; }
    if [[ -L "$dest" ]]; then
      target=$(readlink "$dest")
      [[ "$target" == "$DOTFILES_ROOT/$source" ]] || warn "$dest points outside this checkout"
    else
      warn "$dest is not a symlink"
    fi
  done < <(find "$DOTFILES_ROOT" -maxdepth 2 -type f -name '*.symlink' -print | sed "s#^$DOTFILES_ROOT/##" | sort)
  pass "managed symlink inspection"
}

check_architecture() {
  [[ "$(uname -m)" == arm64 ]] || return
  local file kind
  while IFS= read -r file; do
    kind=$(file -b "$DOTFILES_ROOT/$file")
    case "$kind" in
      'Mach-O 64-bit executable x86_64'*) fail "x86-only binary on arm64: $file" ;;
    esac
  done < <(git -C "$DOTFILES_ROOT" ls-files 'bin/*')
  pass "vendored binary architectures"
}

check_safety_helpers() {
  grep -Fq 'status --short --untracked-files=all' "$DOTFILES_ROOT/zsh/zfunc.symlink/gwrm" ||
    fail "gwrm does not inspect worktree changes"
  grep -Fq 'Re-run with --force' "$DOTFILES_ROOT/zsh/zfunc.symlink/gwrm" ||
    fail "gwrm lacks explicit dirty-worktree override"
  pass "destructive helper safeguards"
}

check_new_thread() {
  "$DOTFILES_ROOT/agents.symlink/skills/new-thread/tests/new-thread-test.sh" ||
    fail "new-thread lifecycle tests"
  pass "new-thread lifecycle"
}

check_configs() {
  git -C "$DOTFILES_ROOT" config --file git/gitconfig.symlink --list >/dev/null || fail "Git config"
  [[ ! -e "$DOTFILES_ROOT/hunk/config.toml" ]] || fail "tracked Hunk runtime config"

  if command -v nvim >/dev/null; then
    nvim --headless '+lua assert(loadfile("nvim/lua/config/commands.lua"))' +qa >/dev/null 2>&1 ||
      fail "Neovim Lua loading"
  fi
  pass "application configs"
}

# --doctor: compare this machine with what setup would produce.
doctor_profile() {
  source "$DOTFILES_ROOT/script/lib.sh"
  if profile="$(read_profile)"; then
    pass "profile: $profile"
  else
    fail "no profile set; run script/setup --profile desktop|runner"
    profile=""
  fi
}

doctor_mise() {
  command -v mise >/dev/null || { fail "mise is not installed"; return; }
  local missing
  missing="$(cd "$HOME" && mise ls --global --missing 2>/dev/null)"
  if [[ -n "$missing" ]]; then
    fail "mise tools not installed (run mise install):"
    printf '       %s\n' "$missing" >&2
  else
    pass "mise tools installed"
  fi
}

doctor_brew() {
  [[ "$(uname -s)" == Darwin ]] || return 0
  command -v brew >/dev/null || { fail "Homebrew is not installed"; return; }
  local brewfiles=(Brewfile) brewfile
  [[ "$profile" == desktop ]] && brewfiles+=(Brewfile.desktop)
  for brewfile in "${brewfiles[@]}"; do
    if brew bundle check --file="$DOTFILES_ROOT/macos/brew/$brewfile" >/dev/null 2>&1; then
      pass "$brewfile installed"
    else
      fail "$brewfile has missing dependencies (run brew bundle check --verbose --file=macos/brew/$brewfile)"
    fi
  done
}

doctor_directories() {
  [[ -d "$HOME/dev" ]] && pass "~/dev exists" || fail "~/dev is missing"
}

cd "$DOTFILES_ROOT"
DOTFILES_ROOT_ORIGINAL="$DOTFILES_ROOT"

if [[ "${1:-}" == --doctor ]]; then
  doctor_profile
  doctor_mise
  doctor_brew
  doctor_directories
  check_symlinks
  printf '\n%d problem(s), %d warning(s)\n' "$failures" "$warnings"
  (( failures == 0 ))
  exit
fi

check_shell_syntax
check_link_safety
check_executables
check_structured_files
check_brewfile
check_linux_dependencies
check_ghostty_linux
check_omarchy_config
check_mise
check_portability
check_architecture
check_safety_helpers
check_new_thread
check_configs

printf '\n%d failure(s), %d warning(s)\n' "$failures" "$warnings"
(( failures == 0 ))
