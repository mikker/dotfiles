#!/usr/bin/env bash
set -euo pipefail

DOTFILES_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export DOTFILES_ROOT

# Shared config assumes the checkout lives at ~/.dotfiles.
EXPECTED_DOTFILES_ROOT="$HOME/.dotfiles"

source "$DOTFILES_ROOT/script/lib.sh"

usage() {
  echo "Usage: script/setup [--profile desktop|runner]"
}

main() {
  local requested_profile=""
  while (( $# > 0 )); do
    case "$1" in
      --profile) requested_profile="${2:-}"; shift 2 || { usage; exit 1; } ;;
      --profile=*) requested_profile="${1#*=}"; shift ;;
      -h|--help) usage; exit 0 ;;
      *) usage; fail "unknown argument: $1" ;;
    esac
  done

  assert_checkout_path
  resolve_profile "$requested_profile"
  echo "Install ($(detect_platform), $DOTFILES_PROFILE profile)"
  submodules
  dependencies
  tools
  symlinks
  platform
  generic
  directories
}

# Picks the profile from --profile, then the saved file, then by asking.
resolve_profile() {
  local profile="$1"

  if [[ -z "$profile" ]]; then
    profile="$(read_profile)" || profile=""
  fi

  if [[ -z "$profile" ]]; then
    local suggested=runner
    if [[ "$(detect_platform)" == macos ]] || is_omarchy; then
      suggested=desktop
    fi

    [[ -t 0 ]] || fail "no profile set for this machine; run script/setup --profile desktop|runner"
    user "Profile for this machine? [desktop/runner] (default: $suggested)"
    IFS= read -r profile
    profile="${profile:-$suggested}"
  fi

  valid_profile "$profile" || fail "unknown profile '$profile' (expected one of: $DOTFILES_PROFILES)"

  mkdir -p "$(dirname "$DOTFILES_PROFILE_FILE")"
  printf '%s\n' "$profile" > "$DOTFILES_PROFILE_FILE"
  DOTFILES_PROFILE="$profile"
  export DOTFILES_PROFILE
}

directories() {
  echo "Create directories"
  mkdir -p "$HOME/dev"
}

assert_checkout_path() {
  if [[ "$DOTFILES_ROOT" == "$EXPECTED_DOTFILES_ROOT" ]]; then
    return
  fi

  fail "expected dotfiles checkout at $EXPECTED_DOTFILES_ROOT, found $DOTFILES_ROOT"
}

submodules() {
  echo "Initialising submodules"
  git -C "$DOTFILES_ROOT" submodule update --init --recursive
}

detect_platform() {
  case "$(uname -s)" in
    Darwin)
      printf 'macos\n'
      ;;
    Linux)
      printf 'linux\n'
      ;;
    MINGW32_NT*|MINGW64_NT*|MSYS_NT*)
      printf 'windows\n'
      ;;
    *)
      printf 'unknown\n'
      ;;
  esac
}

run_installers() {
  local label="$1"
  shift

  local patterns=("$@")
  local find_args=()
  local pattern

  for pattern in "${patterns[@]}"; do
    if (( ${#find_args[@]} > 0 )); then
      find_args+=(-o)
    fi
    find_args+=(-name "$pattern")
  done

  echo "Running $label"

  local installers=()
  local installer
  while IFS= read -r installer; do
    installers+=("$installer")
  done < <(
    find "$DOTFILES_ROOT" -type f \( "${find_args[@]}" \) -print | sort
  )

  for installer in "${installers[@]}"; do
    echo "${installer#$DOTFILES_ROOT/}"
    bash "$installer"
  done
}

platform() {
  local platform_name
  platform_name="$(detect_platform)"

  case "$platform_name" in
    macos)
      run_installers "installers for $platform_name" "macos.sh" "macos.$DOTFILES_PROFILE.sh"
      ;;
    linux)
      run_installers "installers for $platform_name" "linux.sh" "linux.$DOTFILES_PROFILE.sh"
      bash "$DOTFILES_ROOT/linux/shared.sh"
      if is_omarchy; then
        run_installers "Omarchy installers" "omarchy.sh"
      else
        echo "Skipping Omarchy installers; Omarchy not detected"
      fi
      ;;
    windows)
      run_installers "installers for $platform_name" "windows.sh"
      ;;
    *)
      echo "Skipping platform installers for unknown platform"
      ;;
  esac
}

generic() {
  echo "Running generic installers"

  local installer
  for installer in "$DOTFILES_ROOT"/*/all.sh; do
    [[ -f "$installer" ]] || continue
    echo "${installer#$DOTFILES_ROOT/}"
    bash "$installer"
  done
}

dependencies() {
  case "$(detect_platform)" in
    macos)
      command_exists brew || fail "Homebrew is required; install it with Strap first"

      # Standalone setup also needs to handle a pending full-Xcode license.
      local developer_dir
      developer_dir="$(/usr/bin/xcode-select -p)"
      if [[ -x "$developer_dir/usr/bin/xcodebuild" ]] &&
        /usr/bin/xcrun clang --version 2>&1 | grep -qi license; then
        echo "Accepting Xcode license"
        sudo /usr/bin/xcodebuild -license accept
      fi

      echo "Install Homebrew dependencies"
      brew bundle --file "$DOTFILES_ROOT/macos/brew/Brewfile"
      if [[ "$DOTFILES_PROFILE" == desktop ]]; then
        brew bundle --file "$DOTFILES_ROOT/macos/brew/Brewfile.desktop"
      fi
      ;;
    linux)
      run_linux_dependency_installer
      ;;
  esac
}

# mise owns language runtimes and CLI tools. Later installers depend on them,
# so install them right after system packages and expose them on PATH.
tools() {
  if ! command_exists mise; then
    echo "Install mise"
    curl -fsSL https://mise.run | sh
  fi
  export PATH="$HOME/.local/bin:$PATH"
  command_exists mise || fail "mise is not on PATH after installing it"

  link_path "mise/config.toml" "$HOME/.config/mise/config.toml"

  echo "Install mise tools"
  mise install
  eval "$(mise activate bash --shims)"

  # oh-my-posh caches its shell init with an absolute binary path baked in.
  oh-my-posh cache clear >/dev/null

  patch_linux_ruby
}

# Some upstream Linux Ruby archives contain a build-machine RUNPATH. Point the
# executable at the library shipped beside it when that happens.
patch_linux_ruby() {
  [[ "$(uname -s)" == Linux ]] && command_exists patchelf || return 0

  local ruby_bin
  ruby_bin="$(mise where ruby 2>/dev/null)/bin/ruby"
  if [[ -x "$ruby_bin" ]] && ldd "$ruby_bin" 2>/dev/null | grep -q 'libruby.*not found'; then
    patchelf --set-rpath '$ORIGIN/../lib' "$ruby_bin"
  fi
}

run_linux_dependency_installer() {
  local distro_id=""
  local distro_like=""

  if [[ -r /etc/os-release ]]; then
    # This file is shell syntax by specification.
    # shellcheck disable=SC1091
    source /etc/os-release
    distro_id="${ID:-}"
    distro_like="${ID_LIKE:-}"
  fi

  case " $distro_id $distro_like " in
    *" arch "*|*" omarchy "*)
      bash "$DOTFILES_ROOT/linux/arch.sh"
      ;;
    *" debian "*|*" ubuntu "*)
      bash "$DOTFILES_ROOT/linux/ubuntu.sh"
      ;;
    *)
      fail "unsupported Linux distribution '$distro_id'; add its packages to script/setup"
      ;;
  esac
}

symlinks() {
  echo "Create symlinks"

  local overwrite_all=false
  local backup_all=false
  local skip_all=false

  local sources=()
  local source
  while IFS= read -r source; do
    sources+=("$source")
  done < <(
    find "$DOTFILES_ROOT" -maxdepth 2 -type f -name '*.symlink' -print | sort
  )

  local dest action overwrite backup skip
  for source in "${sources[@]}"; do
    dest="$HOME/.${source##*/}"
    dest="${dest%.symlink}"

    if same_link "$dest" "$source"; then
      success "already linked $dest"
      continue
    fi

    if path_exists "$dest"; then
      overwrite=false
      backup=false
      skip=false

      if [[ "$overwrite_all" == false && "$backup_all" == false && "$skip_all" == false ]]; then
        user "File already exists: $(basename "$source"), what do? [s]kip, [S]kip all, [o]verwrite, Overwrite [a]ll, [b]ackup, [B]ackup all?"
        IFS= read -r -n 1 action
        echo

        case "$action" in
          o) overwrite=true ;;
          a) overwrite_all=true ;;
          b) backup=true ;;
          B) backup_all=true ;;
          s) skip=true ;;
          S) skip_all=true ;;
          *) skip=true ;;
        esac
      fi

      if [[ "$overwrite" == true || "$overwrite_all" == true ]]; then
        remove_path "$dest"
        success "removed $dest"
      fi

      if [[ "$backup" == true || "$backup_all" == true ]]; then
        mv "$dest" "$dest.backup"
        success "moved $dest to $dest.backup"
      fi

      if [[ "$skip" == true || "$skip_all" == true ]]; then
        success "skipped $source"
        continue
      fi
    fi

    link_path "$source" "$dest"
  done
}

user() {
  printf '\r  [ \033[0;33m?\033[0m ] %s ' "$1"
}

success() {
  printf '\r\033[2K  [ \033[00;32mOK\033[0m ] %s\n' "$1"
}

fail() {
  printf '\r\033[2K  [\033[0;31mFAIL\033[0m] %s\n' "$1"
  echo
  exit 1
}

main "$@"

