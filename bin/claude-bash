#!/usr/bin/env bash
set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "Usage: claude-bash REQUEST" >&2
  exit 2
fi

request="$*"
echo "Asking Claude for a command suggestion…" >&2

suggestion=$(claude -p "The user wants to: $request

Return one shell command that accomplishes the task. Output only the raw command: no explanation, markdown, or code fences. Never assume the command will be executed automatically; the user will review and edit it first.")
suggestion=$(printf '%s' "$suggestion" | sed '1s/^[[:space:]]*//')

if [[ -z "$suggestion" ]]; then
  echo "Claude returned no command." >&2
  exit 1
fi

printf '%s\n' "$suggestion"
