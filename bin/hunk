#!/bin/sh
set -eu

DOTFILES=${DOTFILES:-$HOME/.dotfiles}
CONFIG_DIR=$HOME/.config/hunk
CONFIG=$CONFIG_DIR/config.toml

if "$DOTFILES/bin/is-this-dark-mode"; then
  SOURCE=$DOTFILES/hunk/config.dark.toml
else
  SOURCE=$DOTFILES/hunk/config.light.toml
fi

mkdir -p "$CONFIG_DIR"
temporary=$(mktemp "$CONFIG_DIR/config.toml.XXXXXX")
trap 'rm -f "$temporary"' EXIT HUP INT TERM
cp "$SOURCE" "$temporary"
mv -f "$temporary" "$CONFIG"
trap - EXIT HUP INT TERM

REAL_HUNK=${REAL_HUNK:-}
if [ -z "$REAL_HUNK" ]; then
  self=$(realpath "$DOTFILES/bin/hunk")
  REAL_HUNK=$(which -a hunk | while IFS= read -r candidate; do
    [ "$(realpath "$candidate")" = "$self" ] && continue
    printf '%s\n' "$candidate"
    break
  done)
fi

if [ -z "$REAL_HUNK" ]; then
  echo "hunk: real executable not found; set REAL_HUNK" >&2
  exit 127
fi

exec "$REAL_HUNK" "$@"
