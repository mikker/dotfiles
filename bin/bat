#!/bin/bash
set -euo pipefail

for candidate in /opt/homebrew/bin/bat /home/linuxbrew/.linuxbrew/bin/bat /usr/local/bin/bat /usr/bin/bat; do
  if [[ -x "$candidate" ]]; then
    bat="$candidate"
    break
  fi
done

if [[ -z "${bat:-}" ]]; then
  echo "bat is not installed" >&2
  exit 127
fi

if [[ "${1-}" == "cache" ]]; then
  exec "$bat" "$@"
fi

if "$(dirname "$0")/is-this-dark-mode"; then
  theme="Zenbones Dark"
else
  theme="Zenbones Light"
fi

exec "$bat" --theme "$theme" "$@"
