#!/bin/bash
set -euo pipefail

# Use the next bat on PATH after this wrapper.
while IFS= read -r candidate; do
  if [[ ! "$candidate" -ef "$0" ]]; then
    bat="$candidate"
    break
  fi
done < <(type -ap bat)

if [[ -z "${bat:-}" ]]; then
  echo "bat is not installed" >&2
  exit 127
fi

if [[ "${1-}" == "cache" ]]; then
  exec "$bat" "$@"
fi

if "$(dirname "$0")/is-this-dark-mode"; then
  theme="Zenbones Dark"
else
  theme="Zenbones Light"
fi

exec "$bat" --theme "$theme" "$@"
