#!/usr/bin/env ruby

require "fileutils"
require "json"
require "open3"
require "optparse"
require "pathname"
require "shellwords"

GLOBAL_CONFIG_DIR = Pathname("~/.config/herdr/projects").expand_path
LOCAL_CONFIG_PATH = Pathname(".herdr/session.toml")
ROUTING_ENV = %w[
  HERDR_PANE_ID
  HERDR_SESSION
  HERDR_SOCKET_PATH
  HERDR_TAB_ID
  HERDR_WORKSPACE_ID
].freeze

def read_toml(path)
  output, error, status = Open3.capture3("yq", "-p=toml", "-o=json", ".", path.to_s)
  raise "cannot read #{path}: #{error.strip}" unless status.success?

  JSON.parse(output)
rescue Errno::ENOENT
  raise "yq is required to read #{path}"
rescue JSON::ParserError => error
  raise "cannot read #{path}: #{error.message}"
end

def nearest_local_config(start)
  start.realpath.ascend do |directory|
    candidate = directory / LOCAL_CONFIG_PATH
    return candidate if candidate.file?
  end
  nil
end

def expanded_path(value, base)
  value = value.gsub(/\$(?:\{([^}]+)\}|([A-Za-z_][A-Za-z0-9_]*))/) do
    ENV.fetch(Regexp.last_match(1) || Regexp.last_match(2), Regexp.last_match(0))
  end
  path = Pathname(value)
  return path.expand_path if value.start_with?("~") || path.absolute?

  (base / path).expand_path
end

def load_config(requested_name)
  global_path = GLOBAL_CONFIG_DIR / "#{requested_name}.toml" if requested_name
  global_config = global_path&.file? ? read_toml(global_path) : {}

  if global_config["root"]
    root = expanded_path(global_config["root"].to_s, Pathname.home)
    local_path = root / LOCAL_CONFIG_PATH
  else
    local_path = nearest_local_config(Pathname.pwd)
    root = local_path ? local_path.parent.parent : Pathname.pwd.realpath
  end

  local_config = local_path&.file? ? read_toml(local_path) : {}
  config = global_config.merge(local_config)
  root = expanded_path(config["root"].to_s, root) if config["root"]
  raise "project root does not exist: #{root}" unless root.directory?

  [requested_name || config["name"] || root.basename.to_s, root, config]
end

def neutral_env
  ENV.to_h.reject { |key, _| ROUTING_ENV.include?(key) }
end

def session_env(name)
  neutral_env.merge("HERDR_SESSION" => name)
end

def run_cli(args, env)
  output, error, status = Open3.capture3(env, "herdr", *args, unsetenv_others: true)
  return output if status.success?

  message = error.strip.empty? ? output.strip : error.strip
  raise "herdr #{args.join(" ")} failed: #{message}"
end

def run_json(args, env)
  output = run_cli(args, env)
  JSON.parse(output)
rescue JSON::ParserError
  raise "invalid Herdr response: #{output.strip}"
end

def sessions
  JSON.parse(run_cli(%w[session list --json], neutral_env)).fetch("sessions")
end

def attach(name)
  exec(neutral_env, "herdr", "session", "attach", name, unsetenv_others: true)
end

def pick_session(available)
  names = available.map { |session| session.fetch("name") }.join("\n")
  names << "\n" unless names.empty?
  output, _, status = Open3.capture3("fzf", stdin_data: names)
  status.success? ? output.strip : nil
rescue Errno::ENOENT
  raise "fzf is required for -a"
end

def command_argv(value, cwd)
  command = case value
  when nil
    return
  when String
    raise "command must be a non-empty string or array of strings" if value.strip.empty?
    value
  when Array
    unless value.any? && value.all? { |argument| argument.is_a?(String) }
      raise "command must be a non-empty string or array of strings"
    end
    value.shelljoin
  else
    raise "command must be a non-empty string or array of strings"
  end

  ["/bin/sh", "-lc", "cd #{cwd.to_s.shellescape} && exec #{command}"]
end

def pane_run(pane_id, command, cwd, env)
  argv = command_argv(command, cwd)
  run_cli(["pane", "run", pane_id, *argv], env) if argv
end

def pane_split(parent_pane, pane, root, env)
  direction = pane.fetch("direction", "right")
  raise "pane direction must be right or down" unless %w[right down].include?(direction)

  cwd = expanded_path(pane.fetch("cwd", ".").to_s, root)
  args = ["pane", "split", "--pane", parent_pane, "--direction", direction, "--cwd", cwd.to_s, "--no-focus"]
  args.concat(["--ratio", pane["ratio"].to_s]) if pane.key?("ratio")
  pane_id = run_json(args, env).dig("result", "pane", "pane_id")
  pane_run(pane_id, pane["command"], cwd, env)
  pane_id
end

def configure_tab(tab_id, root_pane, tab, root, env)
  name = tab.fetch("name", "shell").to_s
  cwd = expanded_path(tab.fetch("cwd", ".").to_s, root)
  run_json(["tab", "rename", tab_id, name], env)
  pane_run(root_pane, tab["command"], cwd, env)

  panes = tab.fetch("panes", [])
  raise "panes for tab #{name} must be an array" unless panes.is_a?(Array)

  created_panes = [root_pane]
  panes.each do |pane|
    raise "each pane for tab #{name} must be a table" unless pane.is_a?(Hash)

    target = Integer(pane.fetch("target", 0))
    raise "pane target #{target} does not exist in tab #{name}" unless target.between?(0, created_panes.length - 1)

    created_panes << pane_split(created_panes[target], pane, root, env)
  end
end

def create_tab(workspace_id, tab, root, env)
  name = tab.fetch("name", "shell").to_s
  cwd = expanded_path(tab.fetch("cwd", ".").to_s, root)
  result = run_json([
    "tab", "create", "--workspace", workspace_id, "--cwd", cwd.to_s,
    "--label", name, "--no-focus"
  ], env).fetch("result")
  tab_id = result.dig("tab", "tab_id")
  configure_tab(tab_id, result.dig("root_pane", "pane_id"), tab, root, env)
  tab_id
end

def start_server(name)
  log_dir = Pathname("~/.local/state/herdr/hdr").expand_path
  FileUtils.mkdir_p(log_dir)
  File.open(log_dir / "#{name}.log", "ab") do |log|
    Process.spawn(
      session_env(name), "herdr", "server",
      in: File::NULL, out: log, err: log, pgroup: true, unsetenv_others: true
    )
  end
end

def wait_for_server(name, pid)
  env = session_env(name)
  100.times do
    if Process.waitpid(pid, Process::WNOHANG)
      raise "Herdr server exited with status #{$?&.exitstatus}"
    end

    _, _, status = Open3.capture3(env, "herdr", "workspace", "list", unsetenv_others: true)
    return if status.success?
    sleep 0.05
  end
  raise "timed out waiting for Herdr server"
end

def bootstrap(name, root, config)
  pid = start_server(name)
  env = session_env(name)
  begin
    wait_for_server(name, pid)
    initial = run_json(%w[workspace list], env).dig("result", "workspaces")
    result = run_json([
      "workspace", "create", "--cwd", root.to_s, "--label", name, "--focus"
    ], env).fetch("result")
    workspace_id = result.dig("workspace", "workspace_id")
    placeholder_tab = result.dig("tab", "tab_id")
    placeholder_pane = result.dig("root_pane", "pane_id")

    tabs = config.fetch("tabs", [])
    raise "tabs must be an array" unless tabs.is_a?(Array)

    if tabs.any?
      raise "each tab must be a table" unless tabs.first.is_a?(Hash)
      configure_tab(placeholder_tab, placeholder_pane, tabs.first, root, env)
    end

    tabs.drop(1).each do |tab|
      raise "each tab must be a table" unless tab.is_a?(Hash)
      create_tab(workspace_id, tab, root, env)
    end

    run_json(["tab", "focus", placeholder_tab], env)
    initial.each { |workspace| run_json(["workspace", "close", workspace.fetch("workspace_id")], env) }
  rescue StandardError
    system(env, "herdr", "server", "stop", out: File::NULL, err: File::NULL, unsetenv_others: true)
    raise
  end
end

def main
  options = { no_attach: !!ARGV.delete("--no-attach") }
  parser = OptionParser.new do |opts|
    opts.banner = "Usage: hdr [-l | -a] [name]"
    opts.on("-l", "--list", "List sessions") { options[:list] = true }
    opts.on("-a", "--attach", "Pick a session with fzf and attach") { options[:attach] = true }
  end
  parser.parse!
  raise OptionParser::InvalidOption, "-l and -a are mutually exclusive" if options[:list] && options[:attach]
  raise OptionParser::InvalidArgument, "too many session names" if ARGV.length > 1

  if options[:list]
    puts sessions.map { |session| session.fetch("name") }
    return
  end

  if options[:attach]
    name = pick_session(sessions)
    attach(name) if name
    return
  end

  name, root, config = load_config(ARGV.first)
  if sessions.any? { |session| session["name"] == name }
    if options[:no_attach]
      puts "hdr: session #{name} already exists"
      return
    end
    attach(name)
  end

  bootstrap(name, root, config)
  if options[:no_attach]
    puts "hdr: started #{name}"
  else
    attach(name)
  end
rescue OptionParser::ParseError => error
  warn "hdr: #{error.message}"
  warn parser
  exit 1
rescue StandardError => error
  abort "hdr: #{error.message}"
end

main if $PROGRAM_NAME == __FILE__
