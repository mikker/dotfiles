#!/usr/bin/env python3
import argparse
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import time
import tomllib

GLOBAL_CONFIG_DIR = Path("~/.config/herdr/projects").expanduser()
LOCAL_CONFIG_PATH = Path(".herdr/session.toml")
ROUTING_ENV = {
    "HERDR_PANE_ID",
    "HERDR_SESSION",
    "HERDR_SOCKET_PATH",
    "HERDR_TAB_ID",
    "HERDR_WORKSPACE_ID",
}


def read_toml(path: Path) -> dict:
    try:
        with path.open("rb") as file:
            return tomllib.load(file)
    except (OSError, tomllib.TOMLDecodeError) as error:
        raise SystemExit(f"hdr: cannot read {path}: {error}")


def nearest_local_config(start: Path) -> Path | None:
    current = start.resolve()
    for directory in (current, *current.parents):
        candidate = directory / LOCAL_CONFIG_PATH
        if candidate.is_file():
            return candidate
    return None


def expanded_path(value: str, base: Path) -> Path:
    expanded = Path(os.path.expandvars(os.path.expanduser(value)))
    return (base / expanded).resolve() if not expanded.is_absolute() else expanded.resolve()


def load_config(requested_name: str | None) -> tuple[str, Path, dict]:
    global_path = GLOBAL_CONFIG_DIR / f"{requested_name}.toml" if requested_name else None
    global_config = read_toml(global_path) if global_path and global_path.is_file() else {}

    if global_config.get("root"):
        root = expanded_path(str(global_config["root"]), Path.home())
        local_path = root / LOCAL_CONFIG_PATH
    else:
        local_path = nearest_local_config(Path.cwd())
        root = local_path.parent.parent if local_path else Path.cwd().resolve()

    local_config = read_toml(local_path) if local_path and local_path.is_file() else {}
    config = {**global_config, **local_config}
    if config.get("root"):
        root = expanded_path(str(config["root"]), root)
    if not root.is_dir():
        raise SystemExit(f"hdr: project root does not exist: {root}")

    name = requested_name or config.get("name") or root.name
    return str(name), root, config


def neutral_env() -> dict[str, str]:
    env = os.environ.copy()
    for key in ROUTING_ENV:
        env.pop(key, None)
    return env


def session_env(name: str) -> dict[str, str]:
    env = neutral_env()
    env["HERDR_SESSION"] = name
    return env


def run_cli(args: list[str], env: dict[str, str]) -> str:
    result = subprocess.run(
        ["herdr", *args],
        env=env,
        text=True,
        capture_output=True,
    )
    if result.returncode != 0:
        message = result.stderr.strip() or result.stdout.strip()
        raise RuntimeError(f"herdr {' '.join(args)} failed: {message}")
    return result.stdout


def run_json(args: list[str], env: dict[str, str]) -> dict:
    output = run_cli(args, env)
    try:
        return json.loads(output)
    except json.JSONDecodeError as error:
        raise RuntimeError(f"invalid Herdr response: {output.strip()}") from error


def sessions() -> list[dict]:
    result = subprocess.run(
        ["herdr", "session", "list", "--json"],
        env=neutral_env(),
        text=True,
        capture_output=True,
        check=True,
    )
    return json.loads(result.stdout)["sessions"]


def attach(name: str) -> None:
    os.execvpe("herdr", ["herdr", "session", "attach", name], neutral_env())


def command_argv(value: object, cwd: Path) -> list[str] | None:
    if value is None:
        return None
    if isinstance(value, str) and value.strip():
        return ["/bin/sh", "-lc", f"cd {shlex.quote(str(cwd))} && exec {value}"]
    if isinstance(value, list) and value and all(isinstance(arg, str) for arg in value):
        command = " ".join(shlex.quote(arg) for arg in value)
        return ["/bin/sh", "-lc", f"cd {shlex.quote(str(cwd))} && exec {command}"]
    raise ValueError("command must be a non-empty string or array of strings")


def pane_run(pane_id: str, command: object, cwd: Path, env: dict[str, str]) -> None:
    argv = command_argv(command, cwd)
    if argv:
        run_cli(["pane", "run", pane_id, *argv], env)


def pane_split(parent_pane: str, pane: dict, root: Path, env: dict[str, str]) -> str:
    direction = pane.get("direction", "right")
    if direction not in {"right", "down"}:
        raise ValueError("pane direction must be right or down")
    cwd = expanded_path(str(pane.get("cwd", ".")), root)
    args = [
        "pane",
        "split",
        "--pane",
        parent_pane,
        "--direction",
        direction,
        "--cwd",
        str(cwd),
        "--no-focus",
    ]
    if "ratio" in pane:
        args.extend(["--ratio", str(pane["ratio"])])
    response = run_json(args, env)
    pane_id = response["result"]["pane"]["pane_id"]
    pane_run(pane_id, pane.get("command"), cwd, env)
    return pane_id


def configure_tab(tab_id: str, root_pane: str, tab: dict, root: Path, env: dict[str, str]) -> None:
    name = str(tab.get("name", "shell"))
    cwd = expanded_path(str(tab.get("cwd", ".")), root)
    run_json(["tab", "rename", tab_id, name], env)
    pane_run(root_pane, tab.get("command"), cwd, env)

    panes = tab.get("panes", [])
    if not isinstance(panes, list):
        raise ValueError(f"panes for tab {name} must be an array")
    created_panes = [root_pane]
    for pane in panes:
        if not isinstance(pane, dict):
            raise ValueError(f"each pane for tab {name} must be a table")
        target = int(pane.get("target", 0))
        if target < 0 or target >= len(created_panes):
            raise ValueError(f"pane target {target} does not exist in tab {name}")
        created_panes.append(pane_split(created_panes[target], pane, root, env))


def create_tab(workspace_id: str, tab: dict, root: Path, env: dict[str, str]) -> str:
    name = str(tab.get("name", "shell"))
    cwd = expanded_path(str(tab.get("cwd", ".")), root)
    response = run_json(
        [
            "tab",
            "create",
            "--workspace",
            workspace_id,
            "--cwd",
            str(cwd),
            "--label",
            name,
            "--no-focus",
        ],
        env,
    )
    result = response["result"]
    tab_id = result["tab"]["tab_id"]
    root_pane = result["root_pane"]["pane_id"]
    configure_tab(tab_id, root_pane, tab, root, env)
    return tab_id


def start_server(name: str) -> subprocess.Popen:
    log_dir = Path("~/.local/state/herdr/hdr").expanduser()
    log_dir.mkdir(parents=True, exist_ok=True)
    log = (log_dir / f"{name}.log").open("ab")
    return subprocess.Popen(
        ["herdr", "server"],
        env=session_env(name),
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )


def wait_for_server(name: str, process: subprocess.Popen) -> None:
    env = session_env(name)
    for _ in range(100):
        if process.poll() is not None:
            raise RuntimeError(f"Herdr server exited with status {process.returncode}")
        result = subprocess.run(
            ["herdr", "workspace", "list"],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        if result.returncode == 0:
            return
        time.sleep(0.05)
    raise RuntimeError("timed out waiting for Herdr server")


def bootstrap(name: str, root: Path, config: dict) -> None:
    process = start_server(name)
    env = session_env(name)
    try:
        wait_for_server(name, process)
        initial = run_json(["workspace", "list"], env)["result"]["workspaces"]
        response = run_json(
            ["workspace", "create", "--cwd", str(root), "--label", name, "--focus"],
            env,
        )["result"]
        workspace_id = response["workspace"]["workspace_id"]
        placeholder_tab = response["tab"]["tab_id"]
        placeholder_pane = response["root_pane"]["pane_id"]

        tabs = config.get("tabs", [])
        if not isinstance(tabs, list):
            raise ValueError("tabs must be an array")

        if tabs:
            first_tab = tabs[0]
            if not isinstance(first_tab, dict):
                raise ValueError("each tab must be a table")
            configure_tab(placeholder_tab, placeholder_pane, first_tab, root, env)

        for tab in tabs[1:]:
            if not isinstance(tab, dict):
                raise ValueError("each tab must be a table")
            create_tab(workspace_id, tab, root, env)

        run_json(["tab", "focus", placeholder_tab], env)

        for workspace in initial:
            run_json(["workspace", "close", workspace["workspace_id"]], env)
    except Exception:
        subprocess.run(
            ["herdr", "server", "stop"],
            env=env,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )
        raise


def main() -> None:
    parser = argparse.ArgumentParser(description="Start or attach to a configured Herdr session")
    parser.add_argument("name", nargs="?", help="session/project name")
    parser.add_argument("--no-attach", action="store_true", help=argparse.SUPPRESS)
    args = parser.parse_args()

    name, root, config = load_config(args.name)
    existing = next((session for session in sessions() if session["name"] == name), None)
    if existing:
        if args.no_attach:
            print(f"hdr: session {name} already exists")
            return
        attach(name)

    try:
        bootstrap(name, root, config)
    except (RuntimeError, ValueError, KeyError, subprocess.SubprocessError) as error:
        raise SystemExit(f"hdr: {error}")

    if args.no_attach:
        print(f"hdr: started {name}")
    else:
        attach(name)


if __name__ == "__main__":
    main()
