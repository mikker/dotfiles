#!/bin/sh
set -eu

usage() {
    status=${1:-2}
    echo "usage: launch-thread <worktree-name> [--workspace-name <title>] [--prompt-file <path>]" >&2
    echo "       launch-thread <worktree-name> [--workspace-name <title>] < prompt.md" >&2
    exit "$status"
}

die() {
    echo "launch-thread: $*" >&2
    exit 1
}

[ "$#" -ge 1 ] || usage
case "$1" in
    -h|--help)
        usage 0
        ;;
esac
worktree_name=$1
shift
workspace_name=$worktree_name
prompt_file=
temporary_prompt=

while [ "$#" -gt 0 ]; do
    case "$1" in
        --workspace-name)
            [ "$#" -ge 2 ] || usage
            workspace_name=$2
            shift 2
            ;;
        --prompt-file)
            [ "$#" -ge 2 ] || usage
            prompt_file=$2
            shift 2
            ;;
        *) usage ;;
    esac
done

for command in git wt fut jq pi; do
    command -v "$command" >/dev/null 2>&1 || die "required command not found: $command"
done

if [ -z "$prompt_file" ]; then
    [ ! -t 0 ] || die "provide a prompt on standard input or with --prompt-file"
    temporary_prompt=$(mktemp "${TMPDIR:-/tmp}/new-thread-prompt.XXXXXX")
    trap 'rm -f "$temporary_prompt"' EXIT HUP INT TERM
    cat > "$temporary_prompt"
    prompt_file=$temporary_prompt
fi
[ -f "$prompt_file" ] || die "prompt file does not exist: $prompt_file"
[ -s "$prompt_file" ] || die "prompt must not be empty"

main_checkout=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
    || die "run from a Git checkout"
main_checkout=$(dirname "$main_checkout")
main_checkout=$(cd "$main_checkout" && pwd -P)

create_output=$(cd "$main_checkout" && wt create "$worktree_name") \
    || die "wt could not create worktree $worktree_name"
worktree_path=$(printf '%s\n' "$create_output" | tail -n 1)
[ -d "$worktree_path" ] || die "wt reported an invalid worktree path: $worktree_path"
worktree_path=$(cd "$worktree_path" && pwd -P)

if ! open_json=$(cd "$main_checkout" && fut --json open --background --name "$workspace_name" "$worktree_path" -- pi --name "$workspace_name"); then
    die "Fut could not create a workspace; worktree retained at $worktree_path"
fi

disposition=$(printf '%s' "$open_json" | jq -er '.result.disposition') \
    || die "Fut returned an unexpected open response; worktree retained at $worktree_path"
[ "$disposition" = "workspace_created" ] \
    || die "Fut disposition was $disposition, not workspace_created; worktree retained at $worktree_path"

workspace_id=$(printf '%s' "$open_json" | jq -er '.result.selected.workspace_id')
pane_id=$(printf '%s' "$open_json" | jq -er '.result.selected.pane_id')
terminal_id=$(printf '%s' "$open_json" | jq -er '.result.selected.terminal_id')
git_dir=$(cd "$worktree_path" && git rev-parse --path-format=absolute --git-dir)
manifest=$git_dir/new-thread.json

jq -n \
    --arg worktree_name "$worktree_name" \
    --arg workspace_name "$workspace_name" \
    --arg worktree_path "$worktree_path" \
    --arg workspace_id "$workspace_id" \
    --arg pane_id "$pane_id" \
    --arg terminal_id "$terminal_id" \
    '{worktree_name: $worktree_name, workspace_name: $workspace_name, worktree_path: $worktree_path, workspace_id: $workspace_id, pane_id: $pane_id, terminal_id: $terminal_id, prompted: false}' \
    > "$manifest"

agent_available=false
attempt=0
while [ "$attempt" -lt 40 ]; do
    if agent_json=$(cd "$main_checkout" && fut --json agent get "$terminal_id" 2>/dev/null) \
        && [ "$(printf '%s' "$agent_json" | jq -r '.result.agent.available // false')" = true ]; then
        agent_available=true
        break
    fi
    attempt=$((attempt + 1))
    sleep 0.25
done
[ "$agent_available" = true ] \
    || die "Pi integration did not become available; inspect terminal $terminal_id (manifest: $manifest)"

workspace_json=$(cd "$main_checkout" && fut --json get "$workspace_id") \
    || die "could not verify workspace $workspace_id (manifest: $manifest)"
workspace_root=$(printf '%s' "$workspace_json" | jq -er '.result.target.workspace.root') \
    || die "workspace response did not contain a root (manifest: $manifest)"
[ ! -d "$workspace_root" ] || workspace_root=$(cd "$workspace_root" && pwd -P)
[ "$workspace_root" = "$worktree_path" ] \
    || die "workspace root $workspace_root does not match $worktree_path (manifest: $manifest)"

if fut agent prompt --help 2>&1 | grep -q -- '--stdin'; then
    prompt_json=$(cd "$main_checkout" && fut --json agent prompt "$terminal_id" --stdin < "$prompt_file") \
        || die "prompt submission failed; inspect terminal $terminal_id (manifest: $manifest)"
else
    prompt_text=$(cat "$prompt_file")
    prompt_json=$(cd "$main_checkout" && fut --json agent prompt "$terminal_id" -- "$prompt_text") \
        || die "prompt submission failed; inspect terminal $terminal_id (manifest: $manifest)"
fi

updated_manifest=$manifest.tmp
jq --argjson prompt "$(printf '%s' "$prompt_json" | jq '.result')" \
    '.prompted = true | .prompt = $prompt' "$manifest" > "$updated_manifest"
mv "$updated_manifest" "$manifest"
cat "$manifest"
