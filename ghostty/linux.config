# Linux overrides, loaded after the shared config by ghostty/linux.sh.
#
# Ghostty sizes are in points. macOS renders 1pt = 1px, Linux uses 96 dpi so
# 1pt = 1.333px. Every point value here is the shared value × 0.75 so the
# terminal renders at the same pixel size on both platforms
# (16pt on macOS = 16px; 12pt on Linux = 16px).
font-size = 12
window-padding-x = 6
window-padding-y = 3,6
