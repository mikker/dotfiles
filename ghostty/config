#font-family = "Iosevka Nerd Font Mono"
#font-family = "JetBrainsMono Nerd Font Mono"
font-family = "Iosevka Curly"
#font-family = "Berkeley Mono"
#font-family = "Cartograph CF"
#font-family = "Cascadia Code NF"
#font-family = "Martian Mono"
#font-family = "SF Mono"
#font-family = "Pragmasevka Nerd Font"
#font-family = "BitstromWera Nerd Font Mono"
#font-family = "IBM Plex Mono"

font-style = "Regular"
font-size = 16
adjust-cell-height = 15%

theme = light:Zenbones Light,dark:Zenbones Dark

cursor-style = block
cursor-style-blink = false
cursor-color = #dd0455
cursor-text = #ffffff
shell-integration-features = no-cursor

window-padding-x = 8
window-padding-y = 4,8
window-colorspace = display-p3
window-height = 36
window-width = 120

# Keep physical scrolling at Ghostty's defaults. FlickRing controls the speed
# of its own synthetic scroll events independently.
mouse-scroll-multiplier = precision:1,discrete:3

#macos-titlebar-style = native
macos-option-as-alt = right
# macos-icon = blueprint

# Word navigation
keybind = opt+arrow_left=text:\x1bb
keybind = opt+arrow_right=text:\x1bf
keybind = opt+backspace=text:\x17

# Line navigation
keybind = cmd+arrow_left=csi:H
keybind = cmd+arrow_right=csi:F
keybind = cmd+backspace=text:\x15

# Herdr workspace switching
keybind = cmd+arrow_up=text:\x02\x1b[A
keybind = cmd+arrow_down=text:\x02\x1b[B

# Command palette
#keybind = cmd+k=toggle_quick_terminal

# Tmux window switching (uses physical bracket keys on Ghostty 1.2+)
keybind = cmd+shift+bracket_left=text:\x02p
keybind = cmd+shift+bracket_right=text:\x02n

# Fut workspace numbers (Ctrl-B w opens the workspace sidebar)
keybind = cmd+digit_1=text:\x02w1
keybind = cmd+digit_2=text:\x02w2
keybind = cmd+digit_3=text:\x02w3
keybind = cmd+digit_4=text:\x02w4
keybind = cmd+digit_5=text:\x02w5
keybind = cmd+digit_6=text:\x02w6
keybind = cmd+digit_7=text:\x02w7
keybind = cmd+digit_8=text:\x02w8
keybind = cmd+digit_9=text:\x02w9

keybind = shift+enter=text:\x1b\r
