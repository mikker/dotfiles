export DOTFILES=$HOME/.dotfiles
export ZSH_FILES=$DOTFILES/zsh
export PROJECTS=$HOME/dev
export XDG_CONFIG_HOME=$HOME/.config

if [[ $OSTYPE == darwin* ]]; then
  export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:$PATH"
fi
export PATH="$DOTFILES/bin:/usr/local/bin:/usr/local/sbin:$PATH"
export VISUAL=nvim
export EDITOR=$VISUAL

source $ZSH_FILES/config.zsh
# source $ZSH_FILES/prompt.zsh
source $ZSH_FILES/bindkeys.zsh
source $ZSH_FILES/aliases.zsh


### Added by Zinit's installer
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    command git clone https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

if [[ -f "$HOME/.local/share/zinit/zinit.git/zinit.zsh" ]]; then
  source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
  autoload -Uz _zinit
  (( ${+_comps} )) && _comps[zinit]=_zinit
fi

zinit light zsh-users/zsh-autosuggestions
zinit light zdharma-continuum/fast-syntax-highlighting

zinit ice lucid wait'0' # what does this first line do?
zinit light joshskidmore/zsh-fzf-history-search

if (( $+commands[oh-my-posh] )); then
  eval "$(oh-my-posh init zsh --config $ZSH_FILES/omp.toml)"
else
  autoload -Uz promptinit && promptinit
  prompt adam1
fi

# All completion directories must be registered before the one compinit call.
[[ -d ~/.docker/completions ]] && fpath=(~/.docker/completions $fpath)
autoload -Uz compinit
if [[ ! -f ~/.zcompdump || -n ~/.zcompdump(#qN.mh+24) ]]; then
  compinit
else
  compinit -C
fi

export PATH="$HOME/.local/bin:$PATH"

if [[ $OSTYPE == darwin* ]]; then
  export PATH="$HOME/Library/Application Support/pear/bin:$PATH"
  # Homebrew's opt symlink survives upgrades; no brew subprocess per shell.
  if (( $+commands[brew] )); then
    _openssl_prefix=${commands[brew]:h:h}/opt/openssl@3
    [[ -d $_openssl_prefix ]] && export RUBY_CONFIGURE_OPTS="--with-openssl-dir=$_openssl_prefix"
    unset _openssl_prefix
  fi
fi

# Local modifications
[[ -f ~/.lrc ]] && . ~/.lrc

# Mise owns language runtimes. Keep this after repository-managed PATH changes.
if (( $+commands[mise] && ! $+functions[_mise_hook] )); then
  eval "$(mise activate zsh)"
fi

# Shell integrations belong here, not in machine-local environment settings.
if (( $+commands[wt] )); then
  eval "$(command wt shellenv zsh)"
fi
if (( $+commands[fut] )); then
  source <(COMPLETE=zsh command fut)
fi

# bun completions
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# Dotfile wrappers intentionally override package-managed executables.
export PATH="$DOTFILES/bin:$PATH"
